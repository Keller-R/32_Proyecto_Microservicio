  },
  "item": [
    {
      "name": "1. MS-Productos (Local - 8081)",
      "item": [
        {
          "name": "Listar Productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/productos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "productos"]
            }
          }
        },
        {
          "name": "Buscar Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/productos/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "productos", "1"]
            }
          }
        },
        {
          "name": "Crear Producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"price\": 1500.00,\n  \"stock\": 10,\n  \"active\": true\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/productos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "productos"]
            }
          }
        },
        {
          "name": "Reducir Stock",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/productos/1/decreaseStock?quantity=2",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "productos", "1", "decreaseStock"],
              "query": [
                {
                  "key": "quantity",
                  "value": "2"
                }
              ]
            }
          }
        }
      ]
    },
